<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for dark mode. -->
    <style name="Theme.AnimeRSSTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color - lighter blue for dark mode -->
        <item name="colorPrimary">@color/dark_primary</item>
        <item name="colorPrimaryVariant">@color/dark_primary_variant</item>
        <item name="colorOnPrimary">@color/dark_background</item>

        <!-- Secondary brand color - green accent -->
        <item name="colorSecondary">@color/dark_secondary</item>
        <item name="colorSecondaryVariant">@color/dark_secondary</item>
        <item name="colorOnSecondary">@color/dark_background</item>

        <!-- Status bar color - pure black for OLED -->
        <item name="android:statusBarColor">@color/dark_background</item>

        <!-- Surface and background colors -->
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/dark_text_secondary</item>
        <item name="android:colorBackground">@color/dark_background</item>

        <!-- Error color -->
        <item name="colorError">@color/error_color_dark</item>
        <item name="colorOnError">@color/dark_background</item>

        <!-- Disable default ActionBar to use custom Toolbar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Dark mode specific text colors -->
        <item name="android:textColorPrimary">@color/dark_text_primary</item>
        <item name="android:textColorSecondary">@color/dark_text_secondary</item>
        <item name="android:textColorTertiary">@color/dark_text_tertiary</item>
        <item name="android:textColorHint">@color/dark_text_tertiary</item>

        <!-- Window background -->
        <item name="android:windowBackground">@color/dark_background</item>

        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/dark_background</item>
    </style>

    <!-- Toolbar theme for dark mode -->
    <style name="Theme.AnimeRSSTracker.Toolbar">
        <item name="android:background">@color/dark_surface</item>
        <item name="android:theme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="popupTheme">@style/ThemeOverlay.AppCompat.Dark</item>
        <item name="titleTextColor">@color/dark_text_primary</item>
    </style>

    <!-- Button styles for dark mode -->
    <style name="Theme.AnimeRSSTracker.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/dark_primary</item>
        <item name="android:textColor">@color/dark_background</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Theme.AnimeRSSTracker.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/dark_primary</item>
        <item name="android:textColor">@color/dark_primary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Card styles for dark mode -->
    <style name="Theme.AnimeRSSTracker.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="cardBackgroundColor">@color/card_background_dark</item>
    </style>

    <!-- Text styles for dark mode -->
    <style name="Theme.AnimeRSSTracker.Text">
        <item name="android:textColor">@color/dark_text_primary</item>
    </style>

    <style name="Theme.AnimeRSSTracker.Text.Title" parent="Theme.AnimeRSSTracker.Text">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dark_text_primary</item>
    </style>

    <style name="Theme.AnimeRSSTracker.Text.Subtitle" parent="Theme.AnimeRSSTracker.Text">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/dark_text_secondary</item>
    </style>

    <style name="Theme.AnimeRSSTracker.Text.Body" parent="Theme.AnimeRSSTracker.Text">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/dark_text_primary</item>
    </style>

    <style name="Theme.AnimeRSSTracker.Text.Caption" parent="Theme.AnimeRSSTracker.Text">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/dark_text_tertiary</item>
    </style>

    <!-- TextInputLayout styles for dark mode -->
    <style name="Theme.AnimeRSSTracker.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/dark_primary</item>
        <item name="hintTextColor">@color/dark_primary</item>
        <item name="android:textColorHint">@color/dark_text_tertiary</item>
    </style>
</resources>
