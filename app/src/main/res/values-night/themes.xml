<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for dark mode. -->
    <style name="Theme.AnimeRSSTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_light</item>
        <item name="colorPrimaryVariant">@color/primary</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary_light</item>
        <item name="colorSecondaryVariant">@color/secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/black</item>
        <!-- Customize your theme here. -->
        <item name="colorSurface">@color/secondary</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:colorBackground">@color/secondary_dark</item>
        <item name="colorError">@color/error_color</item>
        <!-- Disable default ActionBar to use custom Toolbar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Dark mode specific colors -->
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@color/secondary_dark</item>
    </style>

    <!-- Toolbar theme for dark mode -->
    <style name="Theme.AnimeRSSTracker.Toolbar">
        <item name="android:background">@color/secondary</item>
        <item name="android:theme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="popupTheme">@style/ThemeOverlay.AppCompat.Dark</item>
    </style>

    <!-- Button styles for dark mode -->
    <style name="Theme.AnimeRSSTracker.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_light</item>
        <item name="android:textColor">@color/black</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Theme.AnimeRSSTracker.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary_light</item>
        <item name="android:textColor">@color/primary_light</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Card styles for dark mode -->
    <style name="Theme.AnimeRSSTracker.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="cardBackgroundColor">@color/secondary</item>
    </style>

    <!-- Text styles for dark mode -->
    <style name="Theme.AnimeRSSTracker.Text">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Theme.AnimeRSSTracker.Text.Title" parent="Theme.AnimeRSSTracker.Text">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.AnimeRSSTracker.Text.Subtitle" parent="Theme.AnimeRSSTracker.Text">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Theme.AnimeRSSTracker.Text.Body" parent="Theme.AnimeRSSTracker.Text">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Theme.AnimeRSSTracker.Text.Caption" parent="Theme.AnimeRSSTracker.Text">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- TextInputLayout styles for dark mode -->
    <style name="Theme.AnimeRSSTracker.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary_light</item>
        <item name="hintTextColor">@color/primary_light</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>
</resources>
